# Server
PORT=4000
LOG_LEVEL=info
STREAM_CACHE_DIR=.streams

# Plex
PLEX_BASE_URL=http://192.168.1.150:32400
PLEX_TOKEN=example_token

# Streaming defaults
FFMPEG_PATH=
FFMPEG_LOG_LEVEL=verbose
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
VIDEO_CODEC=libx264
VIDEO_PROFILE=high
AUDIO_CODEC=aac
VIDEO_BITRATE=3500k
AUDIO_BITRATE=128k